PROFILES=local # or devcontainer, docker_test, prod (or a combination separated by commas)

#####
# Secret provider: uncomment ONE block.
# SECRET_NAMESPACE is optional and shared by all providers except local:
#   azure -> <namespace>-<name>, aws_ssm -> /<namespace>/<name>,
#   macos -> Keychain account <namespace>, windows -> target <namespace>:<name>

# --- local: secrets come from this file / the environment (values below)
SECRET_PROVIDER=local

# --- macos: macOS Keychain, manage with `appkit-secrets add|update|delete|list|check`
#     (shell completion: eval "$(appkit-secrets completion zsh)")
#SECRET_PROVIDER=macos
#SECRET_NAMESPACE=myapp

# --- windows: Windows Credential Manager, manage with `appkit-secrets ...`
#SECRET_PROVIDER=windows
#SECRET_NAMESPACE=myapp

# --- azure: Azure Key Vault, authenticate with `az login`
#SECRET_PROVIDER=azure
#SECRET_NAMESPACE=myapp
#AZURE_KEY_VAULT_URL=https://<your-vault>.vault.azure.net/

# --- aws_ssm: AWS SSM Parameter Store, authenticate with `aws login --profile myapp-dev`
#SECRET_PROVIDER=aws_ssm
#SECRET_NAMESPACE=myapp/dev
#AWS_PROFILE=myapp-dev
#AWS_REGION=eu-central-1   # only needed if the profile sets no region

#####
# local secret provider values:

mn-db-user=postgres
mn-db-password=postgres
mn-db-host=localhost
mn-db-name=knowledgeai-admin
mn-db-encryption-key=<your-db-encryption-key>

# Azure OAuth
mn-oauth-azure-client-id=<your-azure-oauth-client-id>
mn-oauth-azure-client-secret=<your-azure-oauth-client-secret>
mn-oauth-azure-tenant-id=<your-azure-oauth-tenant-id>

# Github OAuth
mn-oauth-github-client-id=<your-github-oauth-client-id>
mn-oauth-github-client-secret=<your-github-oauth-client-secret>

# Gituhb App
mn-github-app-id=<your-github-app-id>
mn-github-installation-id=<your-github-installation-id>

# OpenAI
mn-openai-api-key=<your-openai-api-key>
mn-openai-api-endpoint=<your-openai-api-endpoint>

# Assistant API Keys
mn-perplexity-api-key=<your-perplexity-api-key>

# Image Generation
mn-google-api-key=<your-google-api-key>
mn-blackforestlabs-api-key=<your-blackforestlabs-api-key>
